{
  "name": "@diviskit/mcp-server",
  "version": "1.6.0",
  "description": "Diviskit MCP server \u2014 Divi 5 Visual Builder + Diviskit Pro commerce automation (Vendokit, FluentCart) as MCP tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "diviskit-mcp": "dist/index.js",
    "diviskit-preset": "dist/preset-cli/bin.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/__tests__/**",
    "!dist/launcher-bootstrap.js",
    "!dist/launcher-bootstrap.d.ts",
    "!dist/launcher-sidecar.js",
    "!dist/launcher-sidecar.d.ts",
    "templates",
    "data/verified-attrs.json",
    "data/verified-attrs-backlog.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "author": "Sascha Kohler",
  "homepage": "https://diviskit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaschaKohler/diviskit-site.git",
    "directory": "diviskit-mcp"
  },
  "bugs": "https://github.com/SaschaKohler/diviskit-site/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "divi",
    "wordpress",
    "visual-builder",
    "model-context-protocol",
    "diviskit",
    "vendokit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "hono": "4.13.1",
    "ip-address": "10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
